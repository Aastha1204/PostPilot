GROQ_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_DAILY_LIMIT_FALLBACK=50
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_TEMPLATE_NAME=
WA_OWNER_NUMBER=
CRON_SECRET=
# Set to true to sync phone approvals through the app server's memory (local demo on one machine or LAN, no Supabase needed)
APPROVAL_LOCAL_SYNC=
SUPABASE_PUBLIC_BUCKET=post-media
# OpenAI: one key powers captions (LLM_MODEL, default gpt-4o-mini) and event images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
